<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="gui.ProgramChooserController"
      alignment="CENTER" spacing="15" style="-fx-padding: 30;"
      stylesheets="@style.css">

    <Label text="Select a Program to Run" style="-fx-font-size: 18px; -fx-text-fill: #4CAF50;"/>
    <ListView fx:id="programsListView" VBox.vgrow="ALWAYS"/>
    <Button text="Run Program" onAction="#displayProgram" prefWidth="200" prefHeight="40"/>
</VBox>